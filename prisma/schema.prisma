// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CategorySlug {
  rebalancing
  grid_trading
  yield_optimisation
  health_factor_monitoring
}

enum AgentSourceType {
  discovered
  self_built
}

model Category {
  slug        CategorySlug @id
  name        String
  description String
  agents      Agent[]
}

model Agent {
  id             String          @id @default(cuid())
  erc8004Id      String?         @unique
  name           String
  description    String
  developer      String
  endpointUrl    String
  chain          String          @default("bsc-testnet")
  walletAddress  String?
  sourceType     AgentSourceType
  categorySlug   CategorySlug
  category       Category        @relation(fields: [categorySlug], references: [slug])
  priceAmount    String?
  priceAsset     String?
  lastHealthCheckAt DateTime?
  latencyMs      Int?
  uptimePct      Float?
  reputationScore Float?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  healthChecks HealthCheck[]
  hires        Hire[]
  reviews      Review[]

  @@index([categorySlug])
}

model HealthCheck {
  id         String   @id @default(cuid())
  agentId    String
  agent      Agent    @relation(fields: [agentId], references: [id])
  timestamp  DateTime @default(now())
  success    Boolean
  latencyMs  Int?
  error      String?

  @@index([agentId, timestamp])
}

enum HireStatus {
  pending
  paid
  completed
  failed
}

model Hire {
  id         String     @id @default(cuid())
  agentId    String
  agent      Agent      @relation(fields: [agentId], references: [id])
  userWallet String?
  txHash     String?
  amount     String?
  asset      String?
  status     HireStatus @default(pending)
  resultData String?
  createdAt  DateTime   @default(now())

  review Review?

  @@index([agentId])
}

model Review {
  id        String   @id @default(cuid())
  hireId    String   @unique
  hire      Hire     @relation(fields: [hireId], references: [id])
  agentId   String
  agent     Agent    @relation(fields: [agentId], references: [id])
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  @@index([agentId])
}
