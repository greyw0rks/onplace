DATABASE_URL="postgresql://postgres:password@localhost:5432/onplaced"

# 8004scan API (apply via hackathon Pro-Tier Upgrade Form)
EIGHT004SCAN_API_KEY=""
EIGHT004SCAN_API_BASE="https://api.8004scan.io"

# BSC
BSC_TESTNET_RPC_URL="https://data-seed-prebsc-1-s1.bnbchain.org:8545"
RELAYER_WALLET_ADDRESS=""
RELAYER_WALLET_PRIVATE_KEY=""
HEALTH_CHECK_LOG_ADDRESS=""

# Shared secret for the scheduled health-check sweep (/api/cron/health-check).
# Vercel Cron sends this automatically as `Authorization: Bearer $CRON_SECRET`.
CRON_SECRET=""

# --- x402 payments (BSC testnet, chain 97) ---
# x402.rs is an open public facilitator whose /supported advertises scheme
# `exact` on eip155:97 and needs no credential. AEON's facilitator also lists
# eip155:97, but its /verify and /settle require an API key issued only through
# KYB-gated merchant onboarding — set the key below if you have one.
X402_FACILITATOR_URL=https://facilitator.x402.rs
X402_FACILITATOR_API_KEY=
# Wallet that receives payments. Defaults to RELAYER_WALLET_ADDRESS.
X402_PAY_TO=
# OnplacedUSD, the EIP-3009 test token the exact scheme settles in. BSC testnet
# has no EIP-3009 asset of its own, so this one is ours — see contracts/OnplacedUSD.sol.
ONPLACED_USD_ADDRESS=0xf7975Eb6A4E13f5929e21b61e9e298e74aFC8f88
